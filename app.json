{
  "expo": {
    "name": "Kidsuu",
    "slug": "kidsuu",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "icon": "./src/shared/assets/brand/app-icon.png",
    "ios": {
      "supportsTablet": true
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFAF2",
          "image": "./src/shared/assets/brand/app-icon.png",
          "imageWidth": 220
        }
      ],
      "expo-status-bar",
      "expo-sqlite",
      [
        "expo-dev-client",
        {
          "launchMode": "launcher",
          "addGeneratedScheme": true
        }
      ]
    ],
    "android": {
      "allowBackup": false,
      "package": "com.kidsuu.app",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    }
  }
}
