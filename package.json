{
  "name": "kidsuu",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run check:assets && npm run check:content",
    "check:assets": "node scripts/check-assets.mjs",
    "check:release": "node scripts/check-release.mjs",
    "verify:bundles": "expo export --platform android --output-dir .expo/verify-android --no-bytecode --max-workers 2 && expo export --platform ios --output-dir .expo/verify-ios --no-bytecode --max-workers 2 && node scripts/check-release-bundles.mjs",
    "audit:dependencies": "npm audit --omit=dev --audit-level=high",
    "backend:check": "npm --prefix backend run check",
    "backend:dev": "npm --prefix backend run dev",
    "qa:start": "node scripts/start-device-qa.mjs",
    "eas-build-post-install": "node scripts/check-eas-build.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:content-release": "node scripts/check-content.mjs --release"
  },
  "dependencies": {
    "expo": "~57.0.27",
    "expo-dev-client": "~57.0.19",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.4",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "prettier": "^3.5.0",
    "typescript": "~6.0.3",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "overrides": {
    "xcode@3.0.1": {
      "uuid": "11.1.1"
    }
  }
}
