{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kidsuu-api-staging",
  "account_id": "094a6f6e25a127dfb82c7f9168c4d241",
  "main": "src/index.ts",
  "tsconfig": "tsconfig.json",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": false },
  "vars": {
    "ENVIRONMENT": "staging",
    "AUTH_ISSUER": "",
    "AUTH_AUDIENCE": "",
    "AUTH_JWKS_URL": "",
    "ALLOWED_ORIGINS": "",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kidsuu-staging",
      "database_id": "a75ed321-9e8f-4f77-8974-cd53addedff5",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "kidsuu-storage",
    },
  ],
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 },
    },
  ],
}
