# Development-only visual review with fictitious accounts; ignored in release builds.
# EXPO_PUBLIC values are embedded in the app: NEVER put secrets here.
EXPO_PUBLIC_AUTH_MODE=demo

# Public staging origin. Dormant until a real token/parent-reauth adapter is supplied.
# Demo family sessions never send requests to this origin.
EXPO_PUBLIC_API_BASE_URL=https://kidsuu-api-staging.kidsuuofficial.workers.dev
